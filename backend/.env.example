# ─────────────────────────────────────────────────────────────
# NeuroAdapt Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL + pgvector) ──────────────────────────
# Local:  postgresql://neuroadapt_user:neuroadapt123@localhost:5432/neuroadapt
# Prod:   managed DB from Railway / Supabase / Neon
DATABASE_URL=postgresql://user:password@host:5432/database

# ── AI / LLM ──────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# ── Cloudinary (image storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auth0 ─────────────────────────────────────────────────────
AUTH0_DOMAIN=https://your-tenant.us.auth0.com
AUTH0_AUDIENCE=http://localhost:3001
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────
# Production frontend URL — added to CORS allowlist
FRONTEND_URL=

# ── Local Auth Testing (scripts/test-auth.js) ─────────────────
# Create a test user in Auth0 Dashboard → User Management → Users
# Also enable Password grant: Apps → LearnNova → Advanced → Grant Types
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_ROLE=individual
